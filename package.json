{
  "name": "live-telemetry-monitoring-system",
  "version": "1.0.0",
  "description": "Live Telemetry & System Monitoring System (MERN Stack) for remote automation fleet tracking",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "server": "node server/server.js",
    "client": "node ./client/node_modules/vite/bin/vite.js client",
    "client:build": "node ./client/node_modules/vite/bin/vite.js build client",
    "build": "node ./client/node_modules/vite/bin/vite.js build client",
    "dev": "node server/server.js",
    "simulate": "node scripts/simulator.js",
    "postinstall": "npm --prefix client install"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongoose": "^8.9.5"
  },
  "keywords": [
    "telemetry",
    "iot",
    "monitoring",
    "mongodb",
    "express",
    "react",
    "node",
    "timeseries",
    "vercel"
  ],
  "author": "",
  "license": "MIT"
}
