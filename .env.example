# MongoDB Connection String (MongoDB Atlas URI or local mongod)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/telemetry_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/telemetry_system

# Server Port (default: 5000)
PORT=5000

# Client Simulator Configuration
# Target endpoint for client packets
SIMULATOR_TARGET_URL=http://localhost:5000/api/telemetry

# Transmission interval in milliseconds (default: 3000ms = 3s)
SIMULATOR_INTERVAL_MS=3000
